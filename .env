# --------------------------------------------------------------------------
# CodeMentor AI - Environment Variables Template
# --------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#   cp .env.example .env
#
# Never commit your real ".env" file to version control.
# --------------------------------------------------------------------------

# Your Groq API key. Get one for free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: host/port overrides for local runs
HOST=0.0.0.0
PORT=7860

# Optional: set to "true" to get a public shareable Gradio link when running locally
GRADIO_SHARE=false
    
